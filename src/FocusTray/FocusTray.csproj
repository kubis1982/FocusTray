<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<ProjectReference Include="..\FocusTray.Core\FocusTray.Core.csproj" />
		<ProjectReference Include="..\FocusTray.Infrastructure\FocusTray.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
		<PackageReference Include="Serilog" Version="4.3.1" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="WPF-UI" Version="4.2.0" />
		<PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\favicon.ico" />
		<Resource Include="Resources\bell-48.ico" />
		<Resource Include="Resources\bell-with-slash-48.ico" />
	</ItemGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Resources\favicon.ico</ApplicationIcon>
		
		<!-- Package Metadata -->
		<Version>0.1.0</Version>
		<Authors>Kubis</Authors>
		<Company>Kubis</Company>
		<Product>FocusTray</Product>
		<Description>A minimalist Windows system tray application that helps you maintain deep focus during work sessions with JIRA integration</Description>
		<Copyright>Copyright © 2026 Kubis</Copyright>
		<PackageProjectUrl>https://github.com/kubis1982/FocusTray</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kubis1982/FocusTray</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>productivity;focus;timer;pomodoro;jira;system-tray;windows</PackageTags>
	</PropertyGroup>

	<!-- Self-contained deployment configuration (Release publishing only) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(PublishDir)' != ''">
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

</Project>