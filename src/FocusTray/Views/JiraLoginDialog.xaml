<Window x:Class="FocusTray.Views.JiraLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login to JIRA" 
        Height="400" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Login to JIRA" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Company -->
        <TextBlock Grid.Row="1" 
                   Text="Company Name:" 
                   Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" 
                 Name="CompanyTextBox"
                 Height="30" 
                 Margin="0,0,0,15"
                 ToolTip="Enter your company name (e.g., 'mycompany' for mycompany.atlassian.net)"/>

        <!-- Email -->
        <TextBlock Grid.Row="3" 
                   Text="Email:" 
                   Margin="0,0,0,5"/>
        <TextBox Grid.Row="4" 
                 Name="EmailTextBox"
                 Height="30" 
                 Margin="0,0,0,15"
                 ToolTip="Your Atlassian account email"/>

        <!-- API Token -->
        <TextBlock Grid.Row="5" 
                   Text="API Token:" 
                   Margin="0,0,0,5"/>
        <PasswordBox Grid.Row="6" 
                     Name="ApiTokenPasswordBox"
                     Height="30" 
                     Margin="0,0,0,10"
                     ToolTip="Your JIRA API token"/>

        <!-- Help Link -->
        <StackPanel Grid.Row="7" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,15">
            <TextBlock Text="Don't have an API token? " 
                       VerticalAlignment="Center"/>
            <TextBlock>
                <Hyperlink NavigateUri="https://id.atlassian.com/manage-profile/security/api-tokens" 
                           RequestNavigate="Hyperlink_RequestNavigate">
                    Generate one here
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Status Message -->
        <TextBlock Grid.Row="7" 
                   Name="StatusTextBlock"
                   TextWrapping="Wrap" 
                   Margin="0,40,0,15"
                   VerticalAlignment="Bottom"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Name="LoginButton" 
                    Content="Test Connection &amp; Login" 
                    Width="180" 
                    Height="35" 
                    Click="Login_Click"
                    Margin="0,0,10,0"/>
            <Button Name="CancelButton" 
                    Content="Cancel" 
                    Width="100" 
                    Height="35" 
                    Click="Cancel_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
