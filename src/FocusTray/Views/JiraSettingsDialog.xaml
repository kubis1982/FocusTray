<Window x:Class="FocusTray.Views.JiraSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JIRA Settings" 
        Height="500" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Enable JIRA -->
        <CheckBox x:Name="EnabledCheckBox"
                  Grid.Row="0"
                  Content="Enable JIRA integration"
                  Margin="0,0,0,20"
                  FontWeight="Bold"/>

        <!-- Base URL -->
        <TextBlock Grid.Row="1" Margin="0,0,0,5"><Run Language="pl-pl" Text="Company"/></TextBlock>
        <TextBox x:Name="CompanyTextBox"
                 Grid.Row="2"
                 Margin="0,0,0,15"
                 Padding="5"
                 ToolTip="e.g., https://yourcompany.atlassian.net"/>

        <!-- Email -->
        <TextBlock Grid.Row="3" Text="Email" Margin="0,0,0,5"/>
        <TextBox x:Name="EmailTextBox"
                 Grid.Row="4"
                 Margin="0,0,0,15"
                 Padding="5"
                 ToolTip="Your Atlassian account email"/>

        <!-- API Token -->
        <TextBlock Grid.Row="5" Text="API Token" Margin="0,0,0,5"/>
        <PasswordBox x:Name="ApiTokenPasswordBox"
                     Grid.Row="6"
                     Margin="0,0,0,15"
                     Padding="5"
                     ToolTip="Generate at https://id.atlassian.com/manage-profile/security/api-tokens"/>

        <!-- JQL Filter -->
        <TextBlock Grid.Row="7" Text="JQL Filter (optional)" Margin="0,0,0,5"/>
        <TextBox x:Name="JqlFilterTextBox"
                 Grid.Row="8"
                 Margin="0,0,0,15"
                 Padding="5"
                 Text="assignee = currentUser() AND statusCategory != Done"
                 TextWrapping="Wrap"
                 ToolTip="Filter issues displayed in task selection"/>

        <!-- Status Message -->
        <TextBlock x:Name="StatusTextBlock"
                    Margin="0,0,0,15"
                   Padding="5"
                   Grid.Row="9"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Test Connection"
                    Width="120"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="TestConnection_Click"/>
            <Button Content="Save"
                    Width="80"
                    Height="30"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Save_Click"/>
            <Button Content="Cancel"
                    Width="80"
                    Height="30"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
